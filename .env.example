# Figma personal access token (Figma → Settings → Security → Personal access tokens)
# Scope needed: "File content: Read-only"
FIGMA_TOKEN=

# Klaviyo PRIVATE API key (Klaviyo → Settings → API keys → Create Private API Key)
# Scopes needed: Campaigns (Read + Write), Templates (Read + Write), Images (Read + Write)
KLAVIYO_PRIVATE_KEY=

# Asana personal access token (Asana → Settings → Apps → Developer apps → Create new token)
# Used to read each email's subject line + preview text and to fill its Link (US) / Link (CA) field
ASANA_TOKEN=

# Optional
# KLAVIYO_REVISION=2026-07-15
# PORT=8787
